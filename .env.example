# Copy to .env (git-ignored). Only LLM_API_KEY is needed, and only for the agents.

# Groq API key for both agents. Without it the pipeline, scoring and heuristic mapping still work.
LLM_API_KEY="replace-with-your-groq-key"
# Groq model both agents use; this is the one the evaluations were run with.
LLM_MODEL_NAME="openai/gpt-oss-120b"
# Warns when false, but actions are never applied without a named human's approval.
AGENT_REQUIRE_APPROVAL="true"

# Optional. The rest have working defaults. Most are read when a process starts, before
# .env is loaded, so set them in the shell (cmd: set NAME=value), not in this file.

# Base URL of the Groq client (read by the Groq SDK); tests point it at a closed local port.
# GROQ_BASE_URL="https://api.groq.com"
# Warehouse file (default data/provenance.duckdb). Point it at a copy for demos.
# PROVENANCE_DUCKDB_PATH="data/provenance.duckdb"
# Where onboarded datasets, run status files and uploads live (default data/datasets).
# PROVENANCE_DATASETS_ROOT="data/datasets"
# Where quarantined dataset batches go (default data/quarantine/datasets).
# PROVENANCE_DATASETS_QUARANTINE_ROOT="data/quarantine/datasets"
# true: load the cached USASpending sample instead of calling the API.
# PROVENANCE_USASPENDING_OFFLINE="false"
# Upload size limit for the console, in MB (default 50).
# DATASET_UPLOAD_MAX_MB="50"
# Below this heuristic confidence, heuristic-first mapping asks the agent (default 0.8).
# MAPPING_AGENT_CONFIDENCE_THRESHOLD="0.8"
# Absolute path to this repo's .dagster folder, for the single-writer run queue.
# DAGSTER_HOME="C:\path\to\provenance\.dagster"
